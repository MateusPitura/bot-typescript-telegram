{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-bot-promo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "41754750c5a6492ba2865b88c76dd233",
    },
  ],
  "triggers": {
    "crons": ["0 15 * * *"], // Every day at 15:00 UTC (12:00 in Brazil)
  },
}
